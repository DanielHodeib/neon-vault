{
  "name": "neon-vault",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore './app/**' --ignore './components/**' server.ts",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && NODE_ENV=production tsx server.ts",
    "test": "tsx --test game/*.test.ts",
    "check": "tsc --noEmit && eslint . && npm test",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "set-role": "tsx scripts/set-role.ts",
    "share": "tailscale funnel 3000"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "prisma": "^6.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
