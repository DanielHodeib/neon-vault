generator client {
  provider = "prisma-client-js"
}

// SQLite is enough: one server process writes, transactions serialize.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MODERATOR
  SUPPORT
  USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  balance      BigInt   @default(10000)
  xp           Int      @default(0)
  createdAt    DateTime @default(now())

  bannedUntil DateTime?
  banReason   String?

  // profile
  avatarUrl String?
  bannerUrl String?
  bio       String  @default("")
  clanTag   String?
  chatColor String?
  rankTag   String  @default("BRONZE")

  // settings
  soundEnabled     Boolean   @default(true)
  theme            String    @default("neon")
  publicProfile    Boolean   @default(true)
  showBalance      Boolean   @default(false)
  showHistory      Boolean   @default(false)
  dailyLimit       BigInt? // self-set cap on stakes per day; null = none
  dailyLimitNext   BigInt? // pending looser limit (null = none) ...
  dailyLimitNextAt DateTime? // ... taking effect at this time (see lib/limits.ts)

  // equipped cosmetics (ids from lib/shop.ts)
  frame      String?
  title      String?
  nameEffect String?

  sessions       Session[]
  ledger         LedgerEntry[]   @relation("LedgerOwner")
  questClaims    QuestClaim[]
  freeSpins      FreeSpins?
  media          Media[]
  notifications  Notification[]
  friendsOut     Friendship[]    @relation("FriendshipFrom")
  friendsIn      Friendship[]    @relation("FriendshipTo")
  blocksOut      Block[]         @relation("BlockFrom")
  blocksIn       Block[]         @relation("BlockTo")
  tickets        Ticket[]
  purchases      ShopPurchase[]
  dmsOut         DirectMessage[] @relation("DmFrom")
  dmsIn          DirectMessage[] @relation("DmTo")
  ticketMessages TicketMessage[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Every balance change is one row. Balance on User is the running total.
model LedgerEntry {
  id             String   @id @default(cuid())
  userId         String
  amount         BigInt // signed
  kind           String // BET | WIN | REFUND | FAUCET | QUEST | TRANSFER | RAIN | ADMIN
  game           String?
  note           String?
  counterpartyId String?
  createdAt      DateTime @default(now())
  user           User     @relation("LedgerOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

model QuestClaim {
  userId      String
  questKey    String
  periodStart DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, questKey, periodStart])
}

// Won free spins, playable on the machine they were won on at the winning stake.
model FreeSpins {
  userId  String  @id
  machine String
  bet     BigInt
  spins   Int
  special String? // expanding symbol of the running round
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Uploaded avatar/banner images. A new upload gets a new id, so /media/<id> can be cached forever.
model Media {
  id        String   @id @default(cuid())
  userId    String
  kind      String // avatar | banner
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Friendship {
  fromId    String
  toId      String
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())
  from      User     @relation("FriendshipFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("FriendshipTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId])
}

model Block {
  fromId String
  toId   String
  from   User   @relation("BlockFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     User   @relation("BlockTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

// Sounds and images the admin uploads for fun effects (admin → Spaß).
model FxAsset {
  id        String   @id @default(cuid())
  kind      String // sound | image
  name      String
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

// Cosmetics a user owns.
model ShopPurchase {
  userId    String
  item      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, item])
}

// Private messages between friends.
model DirectMessage {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  text      String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  from      User      @relation("DmFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User      @relation("DmTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, toId, createdAt])
  @@index([toId, readAt])
}

model Ticket {
  id           String          @id @default(cuid())
  userId       String?
  guestName    String?
  guestContact String?
  subject      String
  category     String
  status       TicketStatus    @default(OPEN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]

  @@index([status])
  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String? // null = guest
  isStaff   Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model SystemSettings {
  id                Int       @id @default(1)
  maintenance       Boolean   @default(false)
  maintenanceEndsAt DateTime?
}
