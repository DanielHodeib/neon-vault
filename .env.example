# SQLite file. connection_limit=1 serializes writes so SQLite never reports "database is locked".
DATABASE_URL="file:./dev.db?connection_limit=1"
PORT=3000
# Optional: second copy of the daily backup, run after each one (see deploy/offsite-backup.sh)
# OFFSITE_BACKUP_CMD="bash /home/ubuntu/neon-vault/deploy/offsite-backup.sh rclone:mycrypt:neon-vault"
